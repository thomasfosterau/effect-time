{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // Tests import the package by name, as a consumer would; the mapping
    // resolves that name to `src/` so the type gate never needs `dist/` first.
    "paths": {
      "@thomasfosterau/effect-time": ["./src/index.ts"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
