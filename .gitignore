# Logs
logs
*.log

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*
!.env.example

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Vitest reports and artifacts
.vitest/
# Built package output (`vp run build`); published to npm, never committed.
dist/

# Generated API reference (`vp run docgen`). Never committed; the README is
# the reference consumers read.
docs/

# The generated git-hook runner; the editable hook itself is committed.
.vite-hooks/_/

# Fallow caches and reports.
.fallow
fallow.sarif

# Claude Code local state.
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
